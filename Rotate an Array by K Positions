public class RotateArray {
 public static void main(String[] args) {
 int[] arr = {1, 2, 3, 4, 5};
 int k = 2;
 int n = arr.length;
 k = k % n;
 for (int count = 0; count < k; count++) {
 int last = arr[n - 1];
 for (int i = n - 1; i > 0; i--)
 arr[i] = arr[i - 1];
 arr[0] = last;
 }
 for (int num : arr)
 System.out.print(num + " ");
 }
}
